# Solana RPC — RPC Fast
# Get hackathon plan: https://t.me/+SpMbJTPTakAxNjdi
NEXT_PUBLIC_RPC_ENDPOINT=
NEXT_PUBLIC_RPC_WS_ENDPOINT=

# RPC Fast (server-side for authenticated endpoints if needed)
RPC_FAST_API_KEY=
RPC_FAST_API_URL=

# Umbra Privacy
# Network: devnet | mainnet
NEXT_PUBLIC_UMBRA_NETWORK=devnet
NEXT_PUBLIC_UMBRA_INDEXER_URL=https://utxo-indexer.api-devnet.umbraprivacy.com
UMBRA_RELAYER_URL=https://relayer.api.umbraprivacy.com

# MagicBlock Private Payments (server-side only — never NEXT_PUBLIC_)
MAGICBLOCK_API_URL=

# Dune SIM (server-side only)
# Get key: https://sim.dune.com
DUNE_SIM_API_KEY=

# Covalent GoldRush (server-side only)
# Get key: https://goldrush.dev
COVALENT_API_KEY=

# Torque Growth (server-side only)
# Get key: https://torque.so
TORQUE_API_KEY=

# Palm USD stablecoin — get mint from hello@palmusd.com or Palm USD Discord
NEXT_PUBLIC_PUSD_MINT=

# ─── BOT Chain (ERC-5564 stealth sends) ──────────────────────────────────────
# Master switch. The whole BOT Chain path is invisible unless this is "true".
NEXT_PUBLIC_BOTCHAIN_ENABLED=false

# Which BOT Chain network to target: "mainnet" (677) or anything else for Bohr testnet (968).
# The listing requirement is satisfied on mainnet, so production must be "mainnet".
NEXT_PUBLIC_BOTCHAIN_NETWORK=testnet

# RPC overrides. Defaults are the public endpoints; set these to swap in a private RPC.
NEXT_PUBLIC_BOTCHAIN_RPC=https://rpc.botchain.ai
NEXT_PUBLIC_BOTCHAIN_WS=wss://ws-rpc.botchain.ai
NEXT_PUBLIC_BOHR_RPC=https://rpc.bohr.life

# WalletConnect project ID — free from https://dashboard.reown.com
# Needed to reach Bo Wallet from a desktop browser, since it ships mobile-only with no extension.
# Without it the app falls back to injected wallets (MetaMask, in-app dApp browsers) only.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Contract addresses, printed by contracts/script/Deploy.s.sol. Suffix is the chain ID.
# Bohr testnet (968)
NEXT_PUBLIC_ANNOUNCER_968=
NEXT_PUBLIC_REGISTRY_968=
NEXT_PUBLIC_STEALTH_SEND_968=
NEXT_PUBLIC_DEPLOY_BLOCK_968=
# BOT Chain mainnet (677)
NEXT_PUBLIC_ANNOUNCER_677=
NEXT_PUBLIC_REGISTRY_677=
NEXT_PUBLIC_STEALTH_SEND_677=
NEXT_PUBLIC_DEPLOY_BLOCK_677=
